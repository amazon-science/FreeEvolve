# GAIA2 CLI-mode defaults, sourced by run.sh.
#
# This is an evaluation environment: it measures an agent on GAIA2 and declares no
# edit surface. There is no `.target` and no ENVIRONMENT.md, because nothing here
# has been chosen as the thing to improve yet.

# The generated task directories, relative to the run directory's eval/.
DATASET_SUBDIR="datasets/gaia2-cli"

# The agent under evaluation, and the model it runs on. claude-code is one of
# harbor's installed agents and registers the task's MCP servers itself, which is
# what CLI mode needs: the ARE apps arrive as MCP tools, not as a shell.
DEFAULT_AGENT="claude-code"
DEFAULT_MODEL="bedrock/global.anthropic.claude-sonnet-4-6"

# The verifier's judge. Separate from the agent on purpose — a judge that is the
# same model as the agent is grading its own family, and this one is also called
# once per oracle/agent action pair in the action-mode configs, so it is the
# cheaper model of the two.
DEFAULT_JUDGE_MODEL="bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0"

# Which GAIA2 configs to materialize, and which scenarios from them.
# GAIA2_IDS_FILE (set at setup time) restricts generation to listed source ids —
# the adapter ships the deterministic 100-task parity subset as
# adapters/gaia2/parity_sample_source_ids.txt, which is what makes a number here
# comparable to the adapter's own reported results.
# Assigned with :- so a caller's value survives being sourced here — setup.sh reads
# this file before it generates, and an unconditional assignment silently discards
# whatever the caller asked for.
GAIA2_CONFIGS="${GAIA2_CONFIGS:-execution search adaptability time ambiguity}"

# Container build/start window. GAIA2 images are cold on a fresh machine and each
# task brings up two containers (agent + ARE sidecar), so the default window trips
# under concurrency and produces start failures that look like agent failures.
ENV_BUILD_TIMEOUT_MULT="4.0"

# Excluded from every run.
ALWAYS_EXCLUDE=""
