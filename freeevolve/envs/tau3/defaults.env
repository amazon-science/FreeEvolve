# tau3-bench defaults, sourced by run.sh.

# The dataset is a local directory generated by setup.sh, passed to harbor via -p.
DATASET_SUBDIR="datasets/tau3-bench"

# harbor imports the agent by this module:class path. The directory holding the
# module goes on PYTHONPATH.
AGENT_IMPORT_PATH="tau3_llm_agent:Tau3LLMAgent"

# The three model roles, all on Bedrock via LiteLLM. Use BARE ids — a "[1m]"
# suffix is a Claude Code alias and is not valid on Bedrock's InvokeModel API.
#   agent : harbor -m
#   user  : TAU2_USER_MODEL, interpolated into the MCP sidecar by compose
#   judge : TAU2_NL_ASSERTIONS_MODEL, injected into the verifier container
DEFAULT_MODEL="bedrock/global.anthropic.claude-opus-4-8"
DEFAULT_USER_MODEL="bedrock/global.anthropic.claude-opus-4-8"
DEFAULT_JUDGE_MODEL="bedrock/global.anthropic.claude-opus-4-8"

# The fixed model capability, as it appears in the agent source. run.sh compares the
# edit surface against the pristine copy setup.sh kept and refuses to evaluate if any
# changed line matches one of these — the knobs live in call arguments and module
# constants, so what can be checked is that the edit did not touch them.
CAPABILITY_KNOBS="max_tokens|MAX_TOKENS|reasoning_effort|REASONING_EFFORT|budget_tokens"

# Excluded from every run.
ALWAYS_EXCLUDE=""

# --- Tasks -------------------------------------------------------------------
# Evolution set: 68 of the 97 banking_knowledge tasks (70%). setup.sh
# materializes only these tasks in an evolution run, then removes the source-only
# VAL_TASKS declaration below from the installed defaults.env. The evolver
# therefore sees one set of 68 tasks and cannot inspect or evaluate the held-out
# tasks.
#
# Within an installed evolution environment, `--split train` and `--split all`
# both resolve to this set. The flag is kept so existing invocations still work.

TRAIN_TASKS="tau3-banking_knowledge-task-002,tau3-banking_knowledge-task-003,tau3-banking_knowledge-task-004,tau3-banking_knowledge-task-005,tau3-banking_knowledge-task-006,tau3-banking_knowledge-task-007,tau3-banking_knowledge-task-008,tau3-banking_knowledge-task-010,tau3-banking_knowledge-task-012,tau3-banking_knowledge-task-015,tau3-banking_knowledge-task-016,tau3-banking_knowledge-task-017,tau3-banking_knowledge-task-018,tau3-banking_knowledge-task-019,tau3-banking_knowledge-task-020,tau3-banking_knowledge-task-022,tau3-banking_knowledge-task-027,tau3-banking_knowledge-task-028,tau3-banking_knowledge-task-031,tau3-banking_knowledge-task-032,tau3-banking_knowledge-task-033,tau3-banking_knowledge-task-036,tau3-banking_knowledge-task-037,tau3-banking_knowledge-task-039,tau3-banking_knowledge-task-041,tau3-banking_knowledge-task-043,tau3-banking_knowledge-task-045,tau3-banking_knowledge-task-047,tau3-banking_knowledge-task-048,tau3-banking_knowledge-task-050,tau3-banking_knowledge-task-051,tau3-banking_knowledge-task-052,tau3-banking_knowledge-task-053,tau3-banking_knowledge-task-054,tau3-banking_knowledge-task-056,tau3-banking_knowledge-task-057,tau3-banking_knowledge-task-058,tau3-banking_knowledge-task-059,tau3-banking_knowledge-task-060,tau3-banking_knowledge-task-061,tau3-banking_knowledge-task-064,tau3-banking_knowledge-task-065,tau3-banking_knowledge-task-066,tau3-banking_knowledge-task-069,tau3-banking_knowledge-task-070,tau3-banking_knowledge-task-071,tau3-banking_knowledge-task-072,tau3-banking_knowledge-task-073,tau3-banking_knowledge-task-075,tau3-banking_knowledge-task-077,tau3-banking_knowledge-task-078,tau3-banking_knowledge-task-079,tau3-banking_knowledge-task-080,tau3-banking_knowledge-task-082,tau3-banking_knowledge-task-084,tau3-banking_knowledge-task-085,tau3-banking_knowledge-task-086,tau3-banking_knowledge-task-088,tau3-banking_knowledge-task-089,tau3-banking_knowledge-task-090,tau3-banking_knowledge-task-091,tau3-banking_knowledge-task-092,tau3-banking_knowledge-task-093,tau3-banking_knowledge-task-095,tau3-banking_knowledge-task-097,tau3-banking_knowledge-task-098,tau3-banking_knowledge-task-099,tau3-banking_knowledge-task-102"

# No held-out split is installed in an evolution run. `--split test` is rejected
# rather than silently aliased, so an invocation cannot access VAL through the
# ordinary evaluation interface.
TEST_TASKS=""


# ---------------------------------------------------------------------------
# FROZEN HELD-OUT METADATA.
# This source-only declaration lets offline evaluation tooling reproduce the
# paper split. TRAIN is what evolution may touch. VAL is reported separately and
# must never be searched on. setup.sh removes this declaration and the
# corresponding task data from every installed evolution environment.
# These lists are frozen: adding to TRAIN retroactively contaminates every VAL
# number.
# 97 banking_knowledge tasks = 68 TRAIN (declared above) + 29 VAL. Verified disjoint.
VAL_TASKS="tau3-banking_knowledge-task-001,tau3-banking_knowledge-task-014,tau3-banking_knowledge-task-021,tau3-banking_knowledge-task-023,tau3-banking_knowledge-task-024,tau3-banking_knowledge-task-025,tau3-banking_knowledge-task-026,tau3-banking_knowledge-task-029,tau3-banking_knowledge-task-034,tau3-banking_knowledge-task-035,tau3-banking_knowledge-task-038,tau3-banking_knowledge-task-040,tau3-banking_knowledge-task-044,tau3-banking_knowledge-task-046,tau3-banking_knowledge-task-049,tau3-banking_knowledge-task-055,tau3-banking_knowledge-task-062,tau3-banking_knowledge-task-063,tau3-banking_knowledge-task-067,tau3-banking_knowledge-task-068,tau3-banking_knowledge-task-074,tau3-banking_knowledge-task-076,tau3-banking_knowledge-task-081,tau3-banking_knowledge-task-083,tau3-banking_knowledge-task-087,tau3-banking_knowledge-task-094,tau3-banking_knowledge-task-096,tau3-banking_knowledge-task-100,tau3-banking_knowledge-task-101"
