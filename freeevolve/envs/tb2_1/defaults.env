# terminal-bench 2.1 defaults, sourced by run.sh.

# Dataset: org/name form resolves to the current head of terminal-bench 2.1.
DATASET="terminal-bench/terminal-bench-2-1"

# --- Fixed: the model capability ---------------------------------------------
# These decide how much inference the agent buys per attempt. They are held
# constant so a change in score means the agent got better rather than bigger.
# run.sh passes them to harbor itself, and refuses to evaluate an edit that has
# changed a line setting one of them. See ENVIRONMENT.md.
#
# Model the terminus-2 agent runs on. Bedrock via LiteLLM. Use the BARE id —
# a "[1m]" suffix is a Claude Code alias and is not valid on Bedrock's
# InvokeModel API.
DEFAULT_MODEL="bedrock/global.anthropic.claude-opus-4-8"
DEFAULT_TEMPERATURE="1.0"
# terminus-2 leaves both of these unset, and they stay unset: setting either buys
# extended thinking the shipped agent does not have. Empty means "do not pass
# it", which is how the agent already runs.
DEFAULT_REASONING_EFFORT=""
DEFAULT_MAX_THINKING_TOKENS=""
# Names that decide capability rather than behaviour. run.sh refuses to evaluate
# an edit that touches a line mentioning one, so a capability purchase cannot be
# mistaken for an improvement. Extend if terminus-2 grows another.
CAPABILITY_KNOBS="reasoning_effort|max_thinking_tokens|temperature|model_name|llm_backend|interleaved_thinking|use_responses_api"

# Multiplier on harbor's container build/start window. TB2.1 images are cold on
# a fresh machine, and a cold-start burst under concurrency otherwise trips the
# default start timeout and produces phantom zeros. Results-neutral: the agent's
# solve budget and the verifier are untouched.
ENV_BUILD_TIMEOUT_MULT="3.0"

# Excluded from every run: failure modes that are about the task, not the agent.
ALWAYS_EXCLUDE="extract-moves-from-video"

# --- The task set ------------------------------------------------------------
# ALL 89 tasks of terminal-bench 2.1, as published — enumerated here so a run
# directory is standalone and says exactly what it was measured on. One set, all
# of it visible and all of it measured: there is no held-out split, `--tasks` picks
# from this set and `--attempts` repeats it. run.sh rejects a request for held-out
# data rather than aliasing it to the set the agent was tuned on.
#
# ALWAYS_EXCLUDE removes one of them, so an evaluation of the whole set is 88 task
# attempts.
TASK_SET="adaptive-rejection-sampler,bn-fit-modify,break-filter-js-from-html,build-cython-ext,build-pmars,build-pov-ray,caffe-cifar-10,cancel-async-tasks,chess-best-move,circuit-fibsqrt,cobol-modernization,code-from-image,compile-compcert,configure-git-webserver,constraints-scheduling,count-dataset-tokens,crack-7z-hash,custom-memory-heap-crash,db-wal-recovery,distribution-search,dna-assembly,dna-insert,extract-elf,extract-moves-from-video,feal-differential-cryptanalysis,feal-linear-cryptanalysis,filter-js-from-html,financial-document-processor,fix-code-vulnerability,fix-git,fix-ocaml-gc,gcode-to-text,git-leak-recovery,git-multibranch,gpt2-codegolf,headless-terminal,hf-model-inference,install-windows-3.11,kv-store-grpc,large-scale-text-editing,largest-eigenval,llm-inference-batching-scheduler,log-summary-date-ranges,mailman,make-doom-for-mips,make-mips-interpreter,mcmc-sampling-stan,merge-diff-arc-agi-task,model-extraction-relu-logits,modernize-scientific-stack,mteb-leaderboard,mteb-retrieve,multi-source-data-merger,nginx-request-logging,openssl-selfsigned-cert,overfull-hbox,password-recovery,path-tracing,path-tracing-reverse,polyglot-c-py,polyglot-rust-c,portfolio-optimization,protein-assembly,prove-plus-comm,pypi-server,pytorch-model-cli,pytorch-model-recovery,qemu-alpine-ssh,qemu-startup,query-optimize,raman-fitting,regex-chess,regex-log,reshard-c4-data,rstan-to-pystan,sam-cell-seg,sanitize-git-repo,schemelike-metacircular-eval,sparql-university,sqlite-db-truncate,sqlite-with-gcov,torch-pipeline-parallelism,torch-tensor-parallelism,train-fasttext,tune-mjcf,video-processing,vulnerable-secret,winning-avg-corewars,write-compressor"


# ---------------------------------------------------------------------------
# FROZEN SPLIT.
# Machine-readable so tooling enforces the split instead of re-deriving it by hand.
# TRAIN is what search may touch. VAL is reported and must never be searched on.
# These lists are frozen: adding to TRAIN retroactively contaminates every VAL number.
# 88 usable of 89 published (ALWAYS_EXCLUDE removes one). 27 TRAIN + 61 VAL.
# TRAIN is an exogenous list of the harder tasks, fixed before any run used it.
# VAL primary metric is mean per-test fraction, not binary resolved.
TRAIN_TASKS="bn-fit-modify,cancel-async-tasks,circuit-fibsqrt,configure-git-webserver,dna-assembly,feal-differential-cryptanalysis,feal-linear-cryptanalysis,fix-code-vulnerability,fix-ocaml-gc,gpt2-codegolf,llm-inference-batching-scheduler,make-doom-for-mips,make-mips-interpreter,mcmc-sampling-stan,model-extraction-relu-logits,password-recovery,path-tracing,path-tracing-reverse,polyglot-rust-c,protein-assembly,regex-chess,sparql-university,torch-pipeline-parallelism,torch-tensor-parallelism,train-fasttext,video-processing,write-compressor"
VAL_TASKS="adaptive-rejection-sampler,break-filter-js-from-html,build-cython-ext,build-pmars,build-pov-ray,caffe-cifar-10,chess-best-move,cobol-modernization,code-from-image,compile-compcert,constraints-scheduling,count-dataset-tokens,crack-7z-hash,custom-memory-heap-crash,db-wal-recovery,distribution-search,dna-insert,extract-elf,filter-js-from-html,financial-document-processor,fix-git,gcode-to-text,git-leak-recovery,git-multibranch,headless-terminal,hf-model-inference,install-windows-3.11,kv-store-grpc,large-scale-text-editing,largest-eigenval,log-summary-date-ranges,mailman,merge-diff-arc-agi-task,modernize-scientific-stack,mteb-leaderboard,mteb-retrieve,multi-source-data-merger,nginx-request-logging,openssl-selfsigned-cert,overfull-hbox,polyglot-c-py,portfolio-optimization,prove-plus-comm,pypi-server,pytorch-model-cli,pytorch-model-recovery,qemu-alpine-ssh,qemu-startup,query-optimize,raman-fitting,regex-log,reshard-c4-data,rstan-to-pystan,sam-cell-seg,sanitize-git-repo,schemelike-metacircular-eval,sqlite-db-truncate,sqlite-with-gcov,tune-mjcf,vulnerable-secret,winning-avg-corewars"
